# Copier ce fichier en .env et remplir les valeurs (ne jamais commiter .env)

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Supabase › Project Settings › Database › Connection string (mode « Session pooler », port 5432)
DATABASE_URL=postgresql://postgres.lyroyrwrufgpeagjtzgv:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi
# Supabase › Project Settings › API
SUPABASE_URL=https://lyroyrwrufgpeagjtzgv.supabase.co
VITE_SUPABASE_URL=https://lyroyrwrufgpeagjtzgv.supabase.co
# Seulement si le projet signe encore les jetons avec l'ancien secret partagé (HS256)
SUPABASE_JWT_SECRET=

# Optionnel : seulement pour envoyer les photos (npm run images:upload).
# ATTENTION : cette clé donne tous les droits sur le projet. Jamais dans Git, jamais dans le front.
# Supabase › Project Settings › API keys › service_role
SUPABASE_SERVICE_ROLE_KEY=

# E-mails transactionnels (Resend › API Keys, accès « Sending » sur notification.kclick-api.com)
# Vide = aucun e-mail envoyé (seulement écrit dans les journaux). Jamais dans Git.
RESEND_API_KEY=
EMAIL_FROM=kclick <commandes@notification.kclick-api.com>
EMAIL_REPLY_TO=ecommerce@kennysinternational.com
# Adresse publique du site (liens de suivi et de connexion dans les e-mails)
PUBLIC_SITE_URL=http://localhost:5173

# Paiements MaishaPay (marchand.maishapay.online › Développeur › Clés API). Jamais dans Git, jamais dans le front.
# Vides = paiements confirmés à la main dans le dashboard.
# Clés de test : MP-SBPK… / MP-SBSK… avec MAISHAPAY_MODE=0 ; clés réelles : MP-LIVEPK… / MP-LIVESK… avec MAISHAPAY_MODE=1
MAISHAPAY_PUBLIC_KEY=
MAISHAPAY_SECRET_KEY=
MAISHAPAY_MODE=0
# Adresse publique de cette API : MaishaPay y envoie le résultat des paiements (HTTPS obligatoire pour la carte)
API_PUBLIC_URL=https://e-commerce-production-46b752b9.up.railway.app
# Au-delà de ce délai, un paiement non validé est considéré comme échoué (le client peut réessayer)
PAYMENT_TIMEOUT_MINUTES=10

# Origines autorisées à appeler l'API, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,https://kclick-demo.netlify.app

