{
  "name": "kclick-server",
  "version": "0.1.0",
  "private": true,
  "description": "API Express de kclick (commandes, dashboards client / employé / livreur / super-admin)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
